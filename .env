# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_LLM_MODEL=ollama_chat/qwen3.5:9b

# Storage
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/research.db

# Crawling
MAX_CONCURRENT_CRAWLS=5
PAGE_TIMEOUT_MS=30000
# Options: enabled | bypass | disabled
CACHE_MODE=enabled

# Content quality thresholds
PRUNING_THRESHOLD=0.45
BM25_THRESHOLD=1.0
MIN_WORD_THRESHOLD=50

# Chunking
# EMBED_MODEL_MAX_TOKENS: hard context-window limit of the embedding model.
# EMBED_TOKENIZER_SAFETY_FACTOR: accounts for the token-count difference between
#   tiktoken cl100k_base (used by the chunker) and BERT-style tokenizers used by
#   Ollama models.  Typical prose: ~1.33x ratio.  URL-dense / minified-code
#   content: up to ~1.8x.  Default 0.6 covers the worst observed case:
#   floor(512 x 0.6 / 8) x 8 = 304 cl100k tokens per chunk.
EMBED_MODEL_MAX_TOKENS=512
# CHUNK_SIZE_TOKENS=304  # auto-derived: floor(512 x 0.6 / 8) x 8
CHUNK_OVERLAP_TOKENS=40

CHUNKING_STRATEGY = overlapping
CHUNK_WINDOW_SIZE_WORDS = 400
CHUNK_OVERLAP_WORDS = 50
LLM_EXTRACTION_ENABLED = true

